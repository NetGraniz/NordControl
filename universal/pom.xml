<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.nordcontrol</groupId><artifactId>nordcontrol-parent</artifactId><version>0.3.0</version></parent>
  <artifactId>nordcontrol-universal</artifactId>
  <dependencies>
    <dependency><groupId>dev.nordcontrol</groupId><artifactId>nordcontrol-paper</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.nordcontrol</groupId><artifactId>nordcontrol-velocity</artifactId><version>${project.version}</version></dependency>
  </dependencies>
  <build>
    <finalName>NordControl-${project.version}</finalName>
    <resources><resource><directory>src/main/resources</directory><filtering>true</filtering></resource></resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
        <createDependencyReducedPom>false</createDependencyReducedPom>
        <filters>
          <filter><artifact>dev.nordcontrol:nordcontrol-paper</artifact><excludes><exclude>plugin.yml</exclude></excludes></filter>
          <filter><artifact>dev.nordcontrol:nordcontrol-velocity</artifact><excludes><exclude>velocity-plugin.json</exclude></excludes></filter>
          <filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude></excludes></filter>
        </filters>
      </configuration></execution></executions></plugin>
    </plugins>
  </build>
</project>
